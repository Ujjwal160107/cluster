{
  "title": "ArgoCD",
  "uid": "argocd-overview",
  "tags": ["infra", "argocd"],
  "schemaVersion": 38,
  "editable": false,
  "id": null,
  "refresh": "30s",
  "time": {"from": "now-5m", "to": "now"},
  "panels": [
    {
      "type": "stat",
      "title": "Total Apps",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "count(argocd_app_info{job=\"argocd\"})"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "blue", "value": null}]
          },
          "color": {"mode": "thresholds"}
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Synced",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "count(argocd_app_info{job=\"argocd\",sync_status=\"Synced\"}) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "green", "value": null}]
          },
          "color": {"mode": "thresholds"}
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Healthy",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "count(argocd_app_info{job=\"argocd\",health_status=\"Healthy\"}) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "green", "value": null}]
          },
          "color": {"mode": "thresholds"}
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "OutOfSync / Degraded",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "(count(argocd_app_info{job=\"argocd\",sync_status!=\"Synced\"}) or vector(0)) + (count(argocd_app_info{job=\"argocd\",health_status=~\"Degraded|Missing\"}) or vector(0))"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          },
          "color": {"mode": "thresholds"}
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "App Status Table",
      "gridPos": {"x": 0, "y": 4, "w": 24, "h": 14},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "argocd_app_info{job=\"argocd\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "server": true,
              "repo": true
            },
            "renameByName": {
              "name": "App",
              "health_status": "Health",
              "sync_status": "Sync",
              "dest_namespace": "Namespace",
              "project": "Project"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": [{"displayName": "App", "desc": false}]
          }
        }
      ],
      "options": {
        "footer": {"show": false},
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Health"},
            "properties": [
              {"id": "custom.displayMode", "value": "color-text"},
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Healthy":     {"color": "green",  "index": 0},
                      "Degraded":    {"color": "red",    "index": 1},
                      "Progressing": {"color": "yellow", "index": 2},
                      "Missing":     {"color": "orange", "index": 3},
                      "Unknown":     {"color": "gray",   "index": 4}
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Sync"},
            "properties": [
              {"id": "custom.displayMode", "value": "color-text"},
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Synced":    {"color": "green",  "index": 0},
                      "OutOfSync": {"color": "orange", "index": 1},
                      "Unknown":   {"color": "gray",   "index": 2}
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
