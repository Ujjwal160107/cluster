      "fieldConfig": {
        "defaults": {"unit": "short"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum(rate({filename=~\"/var/log/containers/.+_vcap-dev_.+\"}[5m]))",
