{
  "title": "Loki",
  "uid": "loki-overview",
  "tags": ["infra", "loki"],
  "schemaVersion": 38,
  "editable": false,
  "id": null,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "type": "stat",
      "title": "Lines/s (total)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "loki", "uid": "loki"},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {"unit": "short"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum(rate({filename=~\".+\"}[5m]))",
          "queryType": "range",
          "editorMode": "code"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Lines/s (vcap-staging)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "loki", "uid": "loki"},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {"unit": "short"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum(rate({filename=~\"/var/log/containers/.+_vcap-staging_.+\"}[5m]))",
          "queryType": "range",
          "editorMode": "code"
        }
      ]
    },
    {
